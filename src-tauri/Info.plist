<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: Tauri bu dosyayı uygulamanın Info.plist'ine ekler. Arayüz, uygulamanın kendi yerel
     sunucusundan (http://127.0.0.1) şifresiz yüklenir; bu izin yalnızca yerel adresleri kapsar. -->
<plist version="1.0">
<dict>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>NSHumanReadableCopyright</key>
  <string>MIT</string>
</dict>
</plist>
